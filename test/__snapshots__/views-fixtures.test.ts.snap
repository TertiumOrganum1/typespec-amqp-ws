"openapi: 3.0.3
info:
  title: Example WebSocket Service
  version: 2.3.4
  description: |-
    End-to-end test fixture covering WebSocket emitter features.

    ---

    **Витрина AsyncAPI-документа.** Этот файл построен из AsyncAPI-описания сервиса
    только для просмотра; кодогенерация и проверки идут от AsyncAPI.
    Транспорт: **WebSocket**.

    | Сервер | Protocol | Host | Pathname | Описание |
    |---|---|---|---|---|
    | \`public\` | \`ws\` | \`localhost:{port}\` | \`/v1/ws\` |  |

    Операции — в разделе путей, у каждой метод POST: «принимает» — сервис получает сообщение,
    «публикует» — сервис отправляет.
externalDocs:
  url: https://example.com/docs
servers:
  - url: ws://localhost:{port}/v1/ws
    description: public
    variables:
      port:
        default: '8080'
        description: WebSocket port
security: []
tags:
  - name: принимает
    description: Сервис получает сообщение
  - name: публикует
    description: Сервис отправляет сообщение
paths:
  /принимает / (receivePing):
    post:
      operationId: receivePing
      summary: receive a ping from the server
      description: |-
        | Поле | Значение |
        |---|---|
        | Направление | принимает — сервис получает сообщение |
        | Канал | \`/\` |
        | Сообщение | \`Ping\` |
        | Content type | \`application/json\` |
      tags:
        - принимает
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Ping'
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
  /принимает / (updateAvailable):
    post:
      operationId: updateAvailable
      summary: notification that an update is available
      description: |-
        | Поле | Значение |
        |---|---|
        | Направление | принимает — сервис получает сообщение |
        | Канал | \`/\` |
        | Сообщение | \`UpdateAvailable\` |
        | Content type | \`application/json\` |
      tags:
        - принимает
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateAvailable'
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
  /публикует / (sendPong):
    post:
      operationId: sendPong
      summary: send a pong in response to a ping
      description: |-
        | Поле | Значение |
        |---|---|
        | Направление | публикует — сервис отправляет сообщение |
        | Канал | \`/\` |
        | Сообщение | \`Pong\` |
        | Content type | \`application/json\` |
      tags:
        - публикует
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Pong'
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
  /публикует / (echo):
    post:
      operationId: echo
      summary: ask server to echo a message and wait for the response
      description: |-
        | Поле | Значение |
        |---|---|
        | Направление | публикует — сервис отправляет сообщение |
        | Канал | \`/\` |
        | Сообщение | \`EchoRequest\` |
        | Content type | \`application/json\` |
        | Ответ | \`EchoResponse\` |
        | Content type ответа | \`application/json\` |
      tags:
        - публикует
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EchoRequest'
      responses:
        '200':
          description: 'Ответ: \`EchoResponse\`'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EchoResponse'
  /публикует / (uploadUpdate):
    post:
      operationId: uploadUpdate
      summary: upload the binary update blob
      description: |-
        Бинарный фрейм без JSON-обёртки: [1B version][N bytes payload].

        | Поле | Значение |
        |---|---|
        | Направление | публикует — сервис отправляет сообщение |
        | Канал | \`/\` |
        | Сообщение | \`UploadUpdate\` |
        | Content type | \`application/octet-stream\` |
      tags:
        - публикует
      requestBody:
        required: true
        description: |-
          upload the binary update blob

          Бинарный фрейм без JSON-обёртки: [1B version][N bytes payload].
        content:
          application/octet-stream:
            schema:
              type: string
              format: binary
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
components:
  schemas:
    PingPayload:
      type: object
      properties:
        ts:
          type: string
      required:
        - ts
      additionalProperties: false
    PongPayload:
      type: object
      properties:
        ts:
          type: string
      required:
        - ts
      additionalProperties: false
    EchoRequestPayload:
      type: object
      properties:
        text:
          type: string
      required:
        - text
      additionalProperties: false
    EchoResponsePayload:
      type: object
      properties:
        text:
          type: string
      required:
        - text
      additionalProperties: false
    UpdateAvailablePayload:
      type: object
      properties:
        version:
          type: string
        url:
          type: string
      required:
        - version
        - url
      additionalProperties: false
    Ping:
      type: object
      properties:
        eventType:
          type: string
          enum:
            - ping
        msgUid:
          type: string
        payload:
          $ref: '#/components/schemas/PingPayload'
      required:
        - eventType
        - msgUid
        - payload
      additionalProperties: false
      description: Server sends a periodic ping; client should reply with Pong
    Pong:
      type: object
      properties:
        eventType:
          type: string
          enum:
            - pong
        msgUid:
          type: string
        payload:
          $ref: '#/components/schemas/PongPayload'
      required:
        - eventType
        - msgUid
        - payload
      additionalProperties: false
      description: Client responds to Ping
    EchoRequest:
      type: object
      properties:
        eventType:
          type: string
          enum:
            - echoRequest
        msgUid:
          type: string
        payload:
          $ref: '#/components/schemas/EchoRequestPayload'
      required:
        - eventType
        - msgUid
        - payload
      additionalProperties: false
      description: Client asks server to echo a message
    EchoResponse:
      type: object
      properties:
        eventType:
          type: string
          enum:
            - echoResponse
        msgUid:
          type: string
        payload:
          $ref: '#/components/schemas/EchoResponsePayload'
      required:
        - eventType
        - msgUid
        - payload
      additionalProperties: false
      description: Server reply with the echoed text
    UpdateAvailable:
      type: object
      properties:
        eventType:
          type: string
          enum:
            - updateAvailable
        msgUid:
          type: string
        payload:
          $ref: '#/components/schemas/UpdateAvailablePayload'
      required:
        - eventType
        - msgUid
        - payload
      additionalProperties: false
      description: Server pushes notification that an update is available
"
`;
