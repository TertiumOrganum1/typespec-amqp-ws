"openapi: 3.0.3
info:
  title: Example AMQP Service
  version: 1.0.0
  description: |-
    End-to-end test fixture covering AMQP publish/consume features.

    ---

    **Витрина AsyncAPI-документа.** Этот файл построен из AsyncAPI-описания сервиса
    только для просмотра; кодогенерация и проверки идут от AsyncAPI.
    Транспорт: **AMQP**.

    | Сервер | Protocol | Host | Pathname | Описание |
    |---|---|---|---|---|
    | \`rabbit\` | \`amqp\` | \`rabbit.example.com:5672\` | \`/example\` | Example RabbitMQ broker |

    Операции — в разделе путей, у каждой метод POST: «принимает» — сервис получает сообщение,
    «публикует» — сервис отправляет.
servers:
  - url: amqp://rabbit.example.com:5672/example
    description: rabbit — Example RabbitMQ broker
security: []
tags:
  - name: принимает
    description: Сервис получает сообщение
  - name: публикует
    description: Сервис отправляет сообщение
paths:
  /принимает v1-events-ack:
    post:
      operationId: consumeAck
      summary: consume acknowledgement commands
      description: |-
        Processes acknowledgement commands from downstream consumers.

        | Поле | Значение |
        |---|---|
        | Направление | принимает — сервис получает сообщение |
        | Routing key | \`v1-events-ack\` |
        | Очередь | \`ack-requests-queue\` |
        | Очередь durable | \`true\` |
        | Очередь autoDelete | \`false\` |
        | Сообщение | \`AckCommand\` |
        | Content type | \`application/json\` |
      tags:
        - принимает
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AckCommand'
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
      x-amqp:
        is: queue
        queue:
          name: ack-requests-queue
          durable: true
          autoDelete: false
  /публикует v1-events-created:
    post:
      operationId: publishEvent
      summary: publish a new event
      description: |-
        Publishes a domain event onto the events exchange.

        Channel for individual domain events

        | Поле | Значение |
        |---|---|
        | Направление | публикует — сервис отправляет сообщение |
        | Routing key | \`v1-events-created\` |
        | Exchange | \`events-exchange\` |
        | Тип exchange | \`direct\` |
        | Exchange durable | \`true\` |
        | Сообщение | \`EventMessage\` |
        | Content type | \`application/json\` |
      tags:
        - публикует
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EventMessage'
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
      x-amqp:
        is: routingKey
        exchange:
          name: events-exchange
          type: direct
          durable: true
  /публикует announcement-broadcast:
    post:
      operationId: broadcastAnnouncement
      summary: broadcast an announcement to all subscribers
      description: |-
        Fanout exchange — every bound queue receives the message.

        | Поле | Значение |
        |---|---|
        | Направление | публикует — сервис отправляет сообщение |
        | Exchange | \`announcements-fanout\` |
        | Тип exchange | \`fanout\` |
        | Exchange durable | \`true\` |
        | Сообщение | \`AnnouncementMessage\` |
        | Content type | \`application/json\` |
      tags:
        - публикует
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AnnouncementMessage'
      responses:
        '202':
          description: 'Ответа нет: сообщение передаётся асинхронно.'
      x-amqp:
        is: routingKey
        exchange:
          name: announcements-fanout
          type: fanout
          durable: true
components:
  schemas:
    Tag:
      type: object
      properties:
        name:
          type: string
          description: Tag name
        value:
          type: string
          description: Tag value
      required:
        - name
        - value
      additionalProperties: false
      description: Key-value tag attached to events
    EventPayload:
      type: object
      properties:
        text:
          type: string
          description: Free-form text
        category:
          $ref: '#/components/schemas/EventCategory'
        priority:
          allOf:
            - $ref: '#/components/schemas/Priority'
          description: Optional priority override
        tags:
          type: array
          items:
            $ref: '#/components/schemas/Tag'
          description: Arbitrary tags
        extra:
          type: object
          additionalProperties:
            type: string
          description: Arbitrary extension parameters
      required:
        - text
        - category
        - tags
        - extra
      additionalProperties: false
      description: Detailed event payload
    EventCategory:
      type: string
      title: EventCategory
      enum:
        - Created
        - Updated
        - Deleted
      description: Category of an event
    Priority:
      type: string
      title: Priority
      enum:
        - Low
        - Normal
        - High
      description: Priority of a notification
    EventMessage:
      type: object
      properties:
        uid:
          allOf:
            - $ref: '#/components/schemas/Uuid'
          description: Unique message identifier
        sentAt:
          $ref: '#/components/schemas/Microseconds'
        payload:
          $ref: '#/components/schemas/EventPayload'
      required:
        - uid
        - sentAt
        - payload
      additionalProperties: false
      description: Event message sent on the events exchange
    Uuid:
      type: string
      description: UUID v7 identifier
    Microseconds:
      type: string
      description: Unix timestamp microseconds as string (to avoid 64-bit precision loss)
    AnnouncementMessage:
      type: object
      properties:
        uid:
          allOf:
            - $ref: '#/components/schemas/Uuid'
          description: Announcement identifier
        message:
          type: string
          description: Announcement text
      required:
        - uid
        - message
      additionalProperties: false
      description: Broadcast announcement, sent via fanout
    AckCommand:
      type: object
      properties:
        uid:
          allOf:
            - $ref: '#/components/schemas/Uuid'
          description: Identifier of the original message being acknowledged
        success:
          type: boolean
          description: Whether the consumer processed the message successfully
        error:
          type: string
          description: Optional error description
      required:
        - uid
        - success
      additionalProperties: false
      description: Acknowledgement command from a consumer back to the producer
"
`;

